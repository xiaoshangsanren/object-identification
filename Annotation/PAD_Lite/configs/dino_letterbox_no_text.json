{
  "seed": 2026,
  "paths": {
    "crop_root": "../datasets/processed/russian_pad",
    "splits_root": "../datasets/Russian-Military-Vehicles/pad_lite_splits_v1",
    "clip_model": "Resource/models/clip-vit-base-patch32",
    "dino_model": "Resource/models/dinov2-small",
    "output_root": "PAD_Lite/outputs/dino_letterbox_no_text_224"
  },
  "data": {
    "input_mode": "letterbox",
    "image_size": 224,
    "resize_short_edge": 256,
    "workers": 4,
    "eval_batch_size": 64,
    "amp": true,
    "exclude_tiny_train": true,
    "exclude_tiny_val": false,
    "exclude_tiny_support": true
  },
  "model": {
    "embedding_dim": 512,
    "dropout": 0.1,
    "unfreeze_last_blocks": 0
  },
  "retrieval": {
    "prototype_top_k": 3
  },
  "b1": {
    "epochs": 30,
    "warmup_epochs": 3,
    "classes_per_batch": 4,
    "instances_per_class": 4,
    "head_lr": 0.0001,
    "backbone_lr": 0.00001,
    "prompt_lr": 0.0,
    "min_lr": 0.0000001,
    "weight_decay": 0.01,
    "gradient_clip": 5.0,
    "label_smoothing": 0.1,
    "id_weight": 1.0,
    "triplet_weight": 1.0,
    "triplet_margin": 0.3,
    "anchor_weight": 0.0,
    "anchor_temperature": 0.07
  },
  "b2": {
    "epochs": 30,
    "warmup_epochs": 5,
    "classes_per_batch": 4,
    "instances_per_class": 4,
    "head_lr": 0.0001,
    "backbone_lr": 0.00001,
    "prompt_lr": 0.0005,
    "min_lr": 0.0000001,
    "weight_decay": 0.01,
    "gradient_clip": 5.0,
    "label_smoothing": 0.1,
    "id_weight": 1.0,
    "triplet_weight": 1.0,
    "triplet_margin": 0.3,
    "anchor_weight": 0.5,
    "anchor_temperature": 0.07,
    "prompt": {
      "context_tokens": 4,
      "prefix": "A photo of a",
      "suffix": "military vehicle.",
      "init_std": 0.02
    }
  }
}
