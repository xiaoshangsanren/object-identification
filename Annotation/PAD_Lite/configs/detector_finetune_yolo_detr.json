{
  "schema_version": 1,
  "name": "detector_finetune_yolo26n_vs_detr_r50_5fold",
  "description": "Five-fold domain fine-tuning comparison on identical raw Russian-Military-Vehicles image splits; all vehicle types are collapsed to one detection class.",
  "paths": {
    "image_root": "../datasets/Russian-Military-Vehicles/train",
    "prepared_root": "PAD_Lite/evaluation_data/detector_finetune_v2",
    "yolo_model": "Resource/models/yolo/yolo26n.pt",
    "detr_model": "Resource/models/detr-resnet-50",
    "output_root": "PAD_Lite/outputs/05_detector_yolo_detr/detector_finetune"
  },
  "split": {
    "version": "detector_stratified_outer5_v2",
    "seed": 2026,
    "fold_count": 5,
    "validation_fraction_of_all_images": 0.1
  },
  "yolo": {
    "epochs": 100,
    "patience": 20,
    "image_size": 640,
    "batch_size": 16,
    "workers": 4
  },
  "detr": {
    "epochs": 30,
    "patience": 8,
    "batch_size": 4,
    "eval_batch_size": 4,
    "workers": 4,
    "learning_rate": 0.0001,
    "backbone_learning_rate": 0.00001,
    "weight_decay": 0.0001,
    "max_grad_norm": 0.1
  },
  "evaluation": {
    "class_name": "military_vehicle",
    "ap_score_floor": 0.001,
    "operating_score_threshold": 0.3,
    "iou_thresholds": [
      0.5,
      0.55,
      0.6,
      0.65,
      0.7,
      0.75,
      0.8,
      0.85,
      0.9,
      0.95
    ],
    "max_detections_per_image": 100,
    "small_object_area": 1024
  }
}
